# Copy to .env.local and fill in. Never commit .env.local.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=reelativemedia.com
MAILGUN_HOST=api.mailgun.net
LEAD_INBOX=sales@funasia.net

# Public analytics ids. These ship to the browser by design.
NEXT_PUBLIC_GA_ID=G-1X5BJWH1PC
NEXT_PUBLIC_CLARITY_ID=ylx5awqzne

# Cloudflare Stream. The site READS its reel list from here; see src/lib/stream.ts.
# Server-only, so no NEXT_PUBLIC_ prefix — that prefix would ship them to the browser.
# The token is scoped to Account > Stream > READ. It never writes.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=

# Optional, LOCAL ONLY, never set on the server: a second token scoped to
# Account > Stream > EDIT, used by tools/stream/set-meta.mjs to write captions.
CLOUDFLARE_STREAM_WRITE_TOKEN=
